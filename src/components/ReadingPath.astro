---
const { quick = [], standard = [], deep = [] } = Astro.props;
const groups = [
  ['5 min', quick],
  ['20 min', standard],
  ['Deep dive', deep]
];
---
<div class="grid">
  {groups.map(([name, items]) => (
    <section class="card">
      <strong>{name}</strong>
      <ol>
        {items.map((item) => <li>{item}</li>)}
      </ol>
    </section>
  ))}
</div>
