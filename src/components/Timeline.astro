---
const { items = [] } = Astro.props;
---
<div class="timeline">
  {items.map((item) => (
    <div class="timeline-item">
      <strong>{item.year} · {item.title}</strong>
      <div>{item.why}</div>
      {item.url && <a href={item.url} target="_blank" rel="noreferrer">Read ↗</a>}
    </div>
  ))}
</div>
